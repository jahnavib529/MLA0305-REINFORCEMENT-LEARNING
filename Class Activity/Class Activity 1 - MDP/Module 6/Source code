import matplotlib.pyplot as plt

# ==========================================================
# MODULE 6 - MDP VISUALIZATION
# ==========================================================

states = ["S1", "S2", "S3"]
actions = ["A1", "A2"]

transition_probabilities = {

    ("S1", "A1"): {"S2": 0.6, "S3": 0.2},
    ("S1", "A2"): {"S2": 0.4, "S3": 0.8},

    ("S2", "A1"): {"S1": 0.7, "S3": 0.5},
    ("S2", "A2"): {"S1": 0.3, "S3": 0.5},

    ("S3", "A1"): {"S1": 0.9, "S2": 0.4},
    ("S3", "A2"): {"S1": 0.1, "S2": 0.6}
}

# ==========================================================
# STATE POSITIONS
# ==========================================================

positions = {
    "S1": (0, 1),
    "S2": (2, 1),
    "S3": (1, -1)
}

fig, ax = plt.subplots(figsize=(11, 8))

# ==========================================================
# DRAW STATES
# ==========================================================

for state, (x, y) in positions.items():

    circle = plt.Circle(
        (x, y),
        0.22,
        color="skyblue",
        ec="black",
        linewidth=2
    )

    ax.add_patch(circle)

    plt.text(
        x,
        y,
        state,
        fontsize=14,
        ha="center",
        va="center",
        fontweight="bold"
    )

# ==========================================================
# DRAW TRANSITIONS
# ==========================================================

for (current_state, action), transitions in \
        transition_probabilities.items():

    x1, y1 = positions[current_state]

    for next_state, probability in transitions.items():

        x2, y2 = positions[next_state]

        if action == "A1":
            color = "blue"
            offset = 0.15
        else:
            color = "red"
            offset = -0.15

        # Arrow
        ax.annotate(
            "",
            xy=(x2, y2),
            xytext=(x1, y1),
            arrowprops=dict(
                arrowstyle="->",
                lw=2,
                color=color,
                shrinkA=20,
                shrinkB=20
            )
        )

        # Label position
        mx = (x1 + x2) / 2
        my = (y1 + y2) / 2

        my += offset

        plt.text(
            mx,
            my,
            f"{action}\nP={probability}",
            fontsize=9,
            color=color,
            ha="center",
            bbox=dict(
                facecolor="white",
                edgecolor=color,
                alpha=0.8
            )
        )

# ==========================================================
# LEGEND
# ==========================================================

plt.plot(
    [],
    [],
    color="blue",
    linewidth=3,
    label="Action A1"
)

plt.plot(
    [],
    [],
    color="red",
    linewidth=3,
    label="Action A2"
)

plt.scatter(
    [],
    [],
    s=300,
    color="skyblue",
    edgecolors="black",
    label="States"
)

plt.legend(loc="upper right")

# ==========================================================
# GRAPH SETTINGS
# ==========================================================

plt.title(
    "MODULE 6 - Markov Decision Process\n"
    "State-Action Transition Diagram",
    fontsize=15,
    fontweight="bold"
)

plt.xlim(-1, 3)
plt.ylim(-2, 2)

plt.xticks([])
plt.yticks([])

plt.grid(
    True,
    linestyle="--",
    alpha=0.4
)

plt.show()
