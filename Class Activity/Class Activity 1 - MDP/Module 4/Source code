import pandas as pd
import matplotlib.pyplot as plt

# ==========================================================
# MODULE 4 - EXPECTED IMMEDIATE REWARD
# ==========================================================

states = ["S1", "S2", "S3"]
actions = ["A1", "A2"]

transition_probabilities = {

    ("S1", "A1"): {"S2": 0.6, "S3": 0.2},
    ("S1", "A2"): {"S2": 0.4, "S3": 0.8},

    ("S2", "A1"): {"S1": 0.7, "S3": 0.5},
    ("S2", "A2"): {"S1": 0.3, "S3": 0.5},

    ("S3", "A1"): {"S1": 0.9, "S2": 0.4},
    ("S3", "A2"): {"S1": 0.1, "S2": 0.6}
}

rewards = {

    ("S1", "A1", "S2"): 5,
    ("S1", "A2", "S2"): 10,

    ("S1", "A1", "S3"): -1,
    ("S1", "A2", "S3"): -5,

    ("S2", "A1", "S1"): 3,
    ("S2", "A2", "S1"): 7,

    ("S2", "A1", "S3"): 2,
    ("S2", "A2", "S3"): 1,

    ("S3", "A1", "S1"): 4,
    ("S3", "A2", "S1"): 6,

    ("S3", "A1", "S2"): 0,
    ("S3", "A2", "S2"): -2
}

# ==========================================================
# CALCULATE EXPECTED REWARDS
# ==========================================================

summary = []

for state in states:

    for action in actions:

        expected_reward = 0

        transitions = transition_probabilities[
            (state, action)
        ]

        for next_state, probability in transitions.items():

            reward = rewards[
                (state, action, next_state)
            ]

            contribution = probability * reward

            expected_reward += contribution

        summary.append([
            state,
            action,
            round(expected_reward, 2)
        ])

# ==========================================================
# CREATE TABLE
# ==========================================================

summary_df = pd.DataFrame(
    summary,
    columns=[
        "State",
        "Action",
        "Expected Immediate Reward"
    ]
)

print("=" * 60)
print("MODULE 4 - EXPECTED IMMEDIATE REWARD")
print("=" * 60)

print(summary_df)

# ==========================================================
# MODULE 4 GRAPH
# ==========================================================

labels = (
    summary_df["State"]
    + "-"
    + summary_df["Action"]
)

values = summary_df[
    "Expected Immediate Reward"
]

plt.figure(figsize=(8, 5))

plt.bar(labels, values)

plt.title(
    "MODULE 4 - Expected Immediate Reward"
)

plt.xlabel("State - Action")
plt.ylabel("Expected Reward")

plt.axhline(
    y=0,
    linewidth=1
)

plt.grid(
    axis="y",
    linestyle="--",
    alpha=0.5
)

plt.show()
